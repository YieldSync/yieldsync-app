# Supabase (required for login / signup / middleware)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias (preferred if you use publishable keys)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mobula API key — historical token prices used to value positions in SOL
MOBULA_API_KEY=334c9d21-cdde-4b83-bc49-b113015ebf76

# Site URL used in OAuth redirects (set in Supabase Dashboard too)
# Add redirect URL: https://app.yieldsync.io/auth/callback
# And for Vercel preview: https://*.vercel.app/auth/callback
